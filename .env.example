PORT=3001
# Connection string privado de Neon; nunca usar el prefijo VITE_.
DATABASE_URL=
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT=10000
# Genera una clave aleatoria de al menos 32 caracteres y mantenla privada.
SESSION_SECRET=
# Gmail API OAuth credentials. Keep every value private; never use the VITE_ prefix.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
# Public HTTPS origin used in password reset and email verification links.
APP_BASE_URL=http://localhost:5180
# Orígenes adicionales permitidos al servir el frontend desde otro dominio.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://192.168.11.157:5180
VITE_API_URL=/api
